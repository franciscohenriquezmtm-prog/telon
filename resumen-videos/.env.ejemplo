# Copie este archivo como ".env" (junto a resumir_videos.py) y complete la clave.
# NUNCA comparta ni suba a git el archivo .env.

# Clave de la API de Gemini (https://aistudio.google.com/apikey), de un proyecto con plan de pago.
GEMINI_API_KEY=

# Opcionales ---------------------------------------------------------------
# Modelo por defecto (equivale a --modelo)
# GEMINI_MODELO=gemini-3.1-flash-lite
# Rutas a ffmpeg/ffprobe propios (si no, se usa el ffmpeg incluido con imageio-ffmpeg)
# FFMPEG_BIN=C:\herramientas\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\herramientas\ffmpeg\bin\ffprobe.exe
# Carpeta donde faster-whisper guarda los modelos descargados (modo --local)
# WHISPER_CACHE=C:\modelos\whisper
